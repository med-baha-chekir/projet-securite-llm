# ============================================================
#  Modèle de configuration — copier en .env (jamais versionné)
#     cp .env.example .env
# ============================================================

# --- Modèle local (Ollama) ---
# llama3.1:8b quantifié (~4,9 Go). Avec 4 Go de VRAM, une partie tourne
# sur la carte graphique et le reste sur le processeur : plus lent mais OK.
# Alternative plus rapide et plus légère : llama3.2:3b
MODEL_NAME=llama3.1:8b

# --- Paramètres de génération : IDENTIQUES pour les versions A et B ---
# Température > 0 pour que les répétitions varient (comme un vrai usage).
LLM_TEMPERATURE=0.7
# Graine de base : la répétition n utilise la graine LLM_SEED + n,
# ce qui rend chaque campagne rejouable à l'identique.
LLM_SEED=42
# Nombre de répétitions par scénario d'attaque (5 minimum).
N_REPETITIONS=5

# --- Secret de test (canary) ---
# Faux secret unique, généré plus tard (étape « données fictives »).
# Format : CANARY- suivi d'un identifiant aléatoire.
CANARY_SECRET=

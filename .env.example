# ============================================================
#  Réglages du labo — FACULTATIF
#  Sans fichier .env, les valeurs ci-dessous sont utilisées par défaut.
#  Pour les modifier : copier en .env (jamais versionné) puis éditer.
#     cp .env.example .env
# ============================================================

# --- Modèle local (Ollama) ---
# llama3.1:8b quantifié (~4,9 Go). Avec 4 Go de VRAM, une partie tourne
# sur la carte graphique et le reste sur le processeur : plus lent mais OK.
# Alternative plus rapide et plus légère : llama3.2:3b
MODEL_NAME=llama3.1:8b
# Modèle d'embeddings (transforme le texte en vecteurs pour le RAG, 274 Mo)
EMBED_MODEL=nomic-embed-text

# Adresse du serveur Ollama.
# Depuis ta machine : http://127.0.0.1:11434
# Depuis un conteneur du labo, elle est remplacée par http://ollama:11434
OLLAMA_URL=http://127.0.0.1:11434

# --- Paramètres de génération : IDENTIQUES pour les versions A et B ---
# Température > 0 pour que les répétitions varient (comme un vrai usage).
LLM_TEMPERATURE=0.7
# Graine de base : la répétition n utilise la graine LLM_SEED + n,
# ce qui rend chaque campagne rejouable à l'identique.
LLM_SEED=42
# Nombre de répétitions par scénario d'attaque (5 minimum).
N_REPETITIONS=5

# --- Secret de test (canary) ---
# Il n'est PAS ici : il est généré automatiquement au premier lancement
# dans secrets/canary.txt (dossier jamais versionné).

# --- Protections de la version B (1 = activée, 0 = désactivée) ---
# Chaque protection se coupe séparément pour mesurer son effet.
PROTECTION_PROMPT_DURCI=1
# Filtre d'entrée : taille maximale du message (2000 caractères par défaut)
PROTECTION_TAILLE_MAX=1
# Filtre d'entrée : nettoyage des caractères invisibles + détection d'injection
PROTECTION_FILTRE_INJECTION=1
# Classifieur de sécurité (Llama Guard 3, 1,6 Go, tourne sur le processeur)
PROTECTION_CLASSIFIEUR=1
GUARD_MODEL=llama-guard3:1b
# Documents du RAG et résultats d'outils : nettoyage + balises <document>
PROTECTION_DOCUMENTS=1
# Outils : chaque outil n'agit que pour le client connecté
PROTECTION_OUTILS=1
# Remboursement et e-mail en attente d'une confirmation du client
PROTECTION_CONFIRMATION=1
# Minimisation : fiche client réduite, documents réservés au personnel écartés
PROTECTION_MINIMISATION=1
# Filtre de sortie : secrets, données des autres clients, images / liens / HTML
PROTECTION_SORTIE_SECRETS=1
PROTECTION_SORTIE_DONNEES=1
PROTECTION_SORTIE_HTML=1
# Réglage d'ANALYSE uniquement : remet le canary dans le prompt durci, pour
# mesurer le filtre de sortie seul. Laisser à 0 en fonctionnement normal.
SECRET_DANS_PROMPT=0
